# Local mode: copy to .env.local, fill in, then `set -a; source .env.local; set +a`.
APP_ENV=local
DATABASE_URL=postgresql://study:study@localhost:5433/study

# LLM: DeepSeek API (summaries, flashcards, quizzes and the chat agent)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Embeddings: Ollama running locally (`ollama pull embeddinggemma-2:270m`)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma-2:270m

# Uploaded PDFs and page texts (the local stand-in for S3)
LOCAL_STORAGE_DIR=.local-data
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Cognito (terraform -chdir=../infra/auth output -raw issuer / app_client_id)
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

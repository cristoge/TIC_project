# Local mode: copy to .env.local, fill in, then `set -a; source .env.local; set +a`.
DATABASE_URL=postgresql://study:study@localhost:5433/study

# LLM for the chat agent, summaries, flashcards and quizzes: "<provider>/<model>".
#   deepseek/<model>   needs DEEPSEEK_API_KEY
#   ollama/<model>     runs on OLLAMA_URL; `ollama pull` it first and pick one with tool calling
#   openai/<model>     any OpenAI-compatible API: OPENAI_API_KEY, and OPENAI_BASE_URL for a server other than OpenAI
#   anthropic/<model>  Claude, e.g. anthropic/claude-sonnet-5-5; ANTHROPIC_API_KEY or an `ant auth login` profile
# Leave this line commented if DEEPSEEK_API_KEY is already exported in your shell:
# an empty value here would override it.
# DEEPSEEK_API_KEY=
LLM_MODEL=deepseek/deepseek-flash
# LLM_MODEL=ollama/qwen3:8b

# Embeddings: Ollama running locally (`ollama pull embeddinggemma-2:270m`)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma-2:270m

# Uploaded PDFs and page texts (the local stand-in for S3)
LOCAL_STORAGE_DIR=.local-data
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Cognito (terraform -chdir=../infra/auth output -raw issuer / app_client_id)
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Lets the phone or simulator reach the agent (without it the agent only listens on 127.0.0.1)
AGENT_HOST=0.0.0.0

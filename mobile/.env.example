# Copy to .env.local (git-ignored) and fill in. Contract: docs/app/README.md § Configuración.
# On a physical phone use the Mac's LAN IP, never 127.0.0.1; on the Android emulator use 10.0.2.2.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
EXPO_PUBLIC_AGENT_URL=http://192.168.1.20:8080/invocations
EXPO_PUBLIC_COGNITO_REGION=eu-south-2
# terraform -chdir=../infra/auth output -raw app_client_id
EXPO_PUBLIC_COGNITO_CLIENT_ID=
